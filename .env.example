PORT=3000

# Base URL from the EnformionGO API reference.
ENFORMION_BASE_URL=https://devapi.enformion.com

# Your Enformion API credentials (sent as galaxy-ap-name / galaxy-ap-password
# headers on every request). Never commit real values -- this file is just a
# template, copy it to .env and fill in the real ones there.
ENFORMION_API_KEY_NAME=your_api_key_name_here
ENFORMION_API_PASSWORD=your_api_password_here

# Defaults match the public reference. Uncomment only to override.
# ENFORMION_PATH_PERSON=/PersonSearch
# ENFORMION_PATH_PHONE=/Phone/Enrich
# ENFORMION_PATH_EMAIL=/Email/Enrich
# ENFORMION_PATH_CONTACT=/Contact/Enrich
# ENFORMION_SEARCH_TYPE_PERSON=Person
# ENFORMION_SEARCH_TYPE_PHONE=DevAPICallerID
# ENFORMION_SEARCH_TYPE_EMAIL=DevAPIEmailID
# ENFORMION_SEARCH_TYPE_CONTACT=DevAPIContactEnrich
