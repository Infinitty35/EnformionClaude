PORT=3000

# Base URL for the Enformion API. See README "Verify against the real docs"
# before going live -- this default is a best-effort guess.
ENFORMION_BASE_URL=https://devapi.enformion.com

# Your Enformion API credentials (sent as galaxy-ap-name / galaxy-ap-password
# headers on every request). Never commit real values -- this file is just a
# template, copy it to .env and fill in the real ones there.
ENFORMION_API_KEY_NAME=your_api_key_name_here
ENFORMION_API_PASSWORD=your_api_password_here

# Only uncomment/change these if the real docs show different endpoint paths
# or galaxy-search-type values than this project's defaults.
# ENFORMION_PATH_PERSON=/PersonSearch
# ENFORMION_PATH_PHONE=/PhoneSearch
# ENFORMION_PATH_EMAIL=/EmailSearch
# ENFORMION_SEARCH_TYPE_PERSON=DevAPIPersonSearch
# ENFORMION_SEARCH_TYPE_PHONE=DevAPIPhoneSearch
# ENFORMION_SEARCH_TYPE_EMAIL=DevAPIEmailSearch
